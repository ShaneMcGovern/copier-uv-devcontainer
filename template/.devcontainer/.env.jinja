{#- Same escape pair as pyproject.toml.jinja, for the same reason. These are
    double-quoted values. An unescaped " ends the value early, and compose
    then reads a broken file. -#}
GIT_AUTHOR_NAME="{{ author_name | replace('\\', '\\\\') | replace('"', '\\"') }}"
GIT_AUTHOR_EMAIL="{{ author_email | replace('\\', '\\\\') | replace('"', '\\"') }}"

# These matter on Linux hosts only, and only if your account is not uid 1000.
# A bind mount passes ownership through unchanged, so the container cannot
# write into /app. Uncomment these, set them to your own `id -u` and `id -g`,
# and rebuild:
#
#   docker compose -f .devcontainer/compose.yaml up -d --build
#
# Windows and macOS map every file to the container user; leave these alone.
# USER_UID=1000
# USER_GID=1000
