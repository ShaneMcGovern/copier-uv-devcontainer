# Copy this file to .env, then fill in your own identity:
#
#   cp .devcontainer/.env.example .devcontainer/.env
#
# If you generated this project yourself, generation already wrote
# .devcontainer/.env from the answers you gave. This committed copy is for
# anyone else who clones the repository.
#
# Do not leave either value empty. Git reads these directly, and they outrank
# user.name. A blank one fails every commit with "fatal: empty ident name".
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"

# These matter on Linux hosts only, and only if your account is not uid 1000.
# A bind mount passes ownership through unchanged, so the container cannot
# write into /app. Uncomment these, set them to your own `id -u` and `id -g`,
# and rebuild:
#
#   docker compose -f .devcontainer/compose.yaml up -d --build
#
# Windows and macOS map every file to the container user; leave these alone.
# USER_UID=1000
# USER_GID=1000
